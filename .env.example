# ===================================================
# DATABASE CONFIGURATION (DEVELOPMENT)
# ===================================================
# Pooled connection string (Transaction mode, port 6543, used by Prisma Client runtime)
DATABASE_URL="postgresql://postgres.[DEV_PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (Session/Direct mode, port 5432, used by Prisma Migrate)
DIRECT_URL="postgresql://postgres.[DEV_PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ===================================================
# SUPABASE API & AUTH (DEVELOPMENT)
# ===================================================
NEXT_PUBLIC_SUPABASE_URL="https://[DEV_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ===================================================
# APPLICATION ENVIRONMENT
# ===================================================
NODE_ENV="development"
