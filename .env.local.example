# ==============================================================================
# ENVIRONMENT: LOCAL (LINUX WORKSTATION)
# ==============================================================================
# Safe local development using host PostgreSQL service (default port 5433 or 5432).
# NEVER points to Cloud Production.
# ==============================================================================

# Active Environment Identifier (LOCAL | CLOUD_DEV | CLOUD_PROD)
APP_ENV="LOCAL"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. LOCAL POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Standard local developer database on host PostgreSQL instance
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5433/pepsi_local?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5433/pepsi_local?schema=public"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION
# ------------------------------------------------------------------------------
# For local development with mock or shared dev authentication.
# In local development, you can point to Dev Supabase Auth (obtoonfhcwwhanvqtkio)
# or local mock Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://obtoonfhcwwhanvqtkio.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_DEV_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_DEV_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------------------
# 3. OPTIONAL LOCAL SYNC & DEPOT TEST CONFIGURATION
# ------------------------------------------------------------------------------
CLOUD_SYNC_BASE_URL="http://localhost:3000"
SYNC_DEVICE_ID="local-dev-device"
SYNC_DEVICE_TOKEN="tok_local_dev_secret"
BUSINESS_TIMEZONE="Asia/Karachi"
