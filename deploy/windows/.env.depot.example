# ==============================================================================
# PEPSI DEPOT RUNTIME ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Do NOT commit the completed file or production secrets to Git!
# 2. Keep permissions on this file restricted to Administrators and the service account.
# 3. Strictly separate environments:
#    - DEV: developer workstations pointing to Supabase dev instance.
#    - DEPOT PRODUCTION: Windows Depot Server pointing to Local PostgreSQL and Cloud Sync.
#    - CLOUD PRODUCTION: Vercel serverless deployment connected to Cloud Supabase.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 1. LOCAL POSTGRESQL DATABASE (DEPOT RUNTIME)
# ------------------------------------------------------------------------------
# The Depot Next.js app and Sync Daemon must connect to the local PostgreSQL instance.
# Local PostgreSQL should listen only on localhost (127.0.0.1:5432).
# Do NOT use a remote Cloud or Supabase URL here!
DATABASE_URL="postgresql://pepsi_admin:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/pepsi_depot?schema=public"

# ------------------------------------------------------------------------------
# 2. CLOUD SYNCHRONIZATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the deployed Cloud instance (e.g. Vercel production app)
CLOUD_SYNC_BASE_URL="https://pepsi-stock-balance.vercel.app"

# Unique identifier for this depot device, registered in Cloud's SyncDevice table.
# Example: "depot-main-server-01"
SYNC_DEVICE_ID="depot-main-server-01"

# Cryptographically strong bearer token matching the SHA-256 hash registered in Cloud.
# Generated during device registration.
SYNC_DEVICE_TOKEN="REPLACE_WITH_PROVISIONED_DEVICE_TOKEN"

# Optional Sync Daemon tuning (defaults: normal=30000ms, debounce=1000ms)
SYNC_NORMAL_INTERVAL_MS=30000
SYNC_DEBOUNCE_MS=1000

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION (FOR CASHIER / OWNER LOGIN)
# ------------------------------------------------------------------------------
# Note: For staff/cashier logins on LAN, Supabase Auth public project credentials
# are used to authenticate JWT tokens against your production Cloud project.
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_WITH_PROD_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_PROD_SUPABASE_ANON_KEY"

# Service role key (used only for administrative user provisioning actions)
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_PROD_SUPABASE_SERVICE_ROLE_KEY"
